# Copy to .env for local development. Real environment variables override this file.
APP_ENV=local
APP_VERSION=1.0.0
PROBLEM_BASE_URI=https://api.smartheart.example.in/problems

# Homebrew MySQL 8.4: root with no password over the local socket.
DB_NAME=smart_heart
DB_USER=root
DB_PASSWORD=
DB_SOCKET=/tmp/mysql.sock
# Or TCP (CI, Docker, servers): leave DB_SOCKET empty and set these.
DB_HOST=127.0.0.1
DB_PORT=3306

# Keys: generate with `php bin/generate-secrets.php >> .env`. On servers, set them as environment
# variables (never commit them). See src/Infra/Secrets.php for rotation.
JWT_SIGNING_KEY_ID=k1
JWT_SIGNING_KEY=
CASE_NUMBER_PEPPER_CURRENT=1
CASE_NUMBER_PEPPER_1=
DATA_ENCRYPTION_KEY_ID=1
DATA_ENCRYPTION_KEY=
STUDY_HELPLINE=[STUDY HELPLINE NUMBER]
