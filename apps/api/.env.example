APP_NAME="SMART-HEART eCRF"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example
APP_TIMEZONE=Asia/Kolkata

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

# ---- Database (MySQL on HostingRaja) ----
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_smartheart
DB_USERNAME=cpaneluser_shi
DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# ---- Study settings ----
STUDY_NAME=SMART-HEART
STUDY_SITE="Sri Ramachandra Medical Centre"
STUDY_ID_PREFIX=SMART-HEART-
SCREENING_ID_PREFIX=SCR-
# First number to issue. If paper CRFs already used SMART-HEART-0001..0005, set 6.
STUDY_ID_START=1

# ---- Security ----
SESSION_IDLE_MINUTES=15
SESSION_MAX_HOURS=12
LOGIN_LOCKOUT_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ---- Blinded arm codes for the statistician export ----
ARM_CODE_INTERVENTION=A
ARM_CODE_CONTROL=B

# ---- Backups (php artisan shi:backup runs daily via the scheduler) ----
# Generate with:  php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
# Store a copy of this key OFF the server. Without it backups cannot be read.
BACKUP_KEY=
BACKUP_KEEP_DAYS=30

# ---- First administrator (php artisan db:seed --force) ----
SEED_ADMIN_NAME="System Administrator"
SEED_ADMIN_EMAIL=admin@smartheart.local
SEED_ADMIN_PASSWORD=

# ---- Phase 2: eligibility, baseline, safety ----
# Phone types allowed at screening (comma list). Android only for this trial.
ELIGIBLE_PHONE_OS=android
BASELINE_REQUIRED_PROS=PRO-PHQ9,PRO-GAD7,PRO-EQ5D,PRO-DASI,PRO-MARS5
# PHQ-9 item 9 alerts: emailed at once to these, then to the escalation list if not acknowledged in time.
ALERT_CRITICAL_EMAILS=
ALERT_ESCALATION_EMAILS=
ALERT_ESCALATE_AFTER_HOURS=2
# Shown to the participant (tablet and app) when they need to contact the team.
STUDY_COORDINATOR_PHONE=
SELF_ENTRY_MINUTES=60
# CCSPS normalisation from the SAP: undecided | complete_case | proportional
CCSPS_NORMALISATION=undecided
# Outgoing mail for alerts (cPanel email account). MAIL_MAILER=log writes to storage/logs instead.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=smtps
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="SMART-HEART"

# ---- Phase 3: participant app ----
# Firebase project used for SMS OTP sign-in (Project settings → Project ID).
FIREBASE_PROJECT_ID=
# Service-account key for push notifications. Full path, OUTSIDE public_html, e.g. /home/USER/secure/firebase.json
FIREBASE_CREDENTIALS=
APP_TOKEN_DAYS=90
APP_MAX_CAREGIVERS=2
# Home readings that raise a warning alert for the study team (PI to confirm before go-live).
APP_ALERT_SBP_HIGH=180
APP_ALERT_DBP_HIGH=110
APP_ALERT_SBP_LOW=90
APP_ALERT_GLUCOSE_HIGH=300
APP_ALERT_GLUCOSE_LOW=70
# Local development ONLY (also needs APP_ENV=local): lets the app sign in with "dev:+91XXXXXXXXXX".
APP_DEV_LOGIN=false
